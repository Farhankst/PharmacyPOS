@page "/products/edit/{Id:int}"

@using PharmacyPOS.Application.DTOs.Products
@using PharmacyPOS.Web.Services.ApiClients

@inject ProductApiClient ProductApi
@inject NavigationManager Navigation

<h3>Edit Product</h3>

@if (loading)
{
    <p>Loading Product...</p>
}
else if (model == null)
{
    <div class="alert alert-danger" role="alert">@error</div>
    <a class="btn btn-secondary" href="/products">Back to List</a>
}
else
{
    @if (!string.IsNullOrEmpty(error))
    {
        <div class="alert alert-danger" role="alert">@error</div>
    }

    <fieldset disabled="@saving">
        <div class="mb-3">
            <label for="product-code">Product Code</label>
            <input id="product-code" class="form-control" @bind="model.Code" />
        </div>
        <div class="mb-3">
            <label for="product-name">Product Name</label>
            <input id="product-name" class="form-control" @bind="model.Name" />
        </div>
        <div class="mb-3">
            <label for="unit-price">Unit Price</label>
            <input id="unit-price" type="number" step="0.01" min="0"
                   class="form-control" @bind="model.UnitPrice" />
        </div>

        <button class="btn btn-primary" @onclick="Save" disabled="@saving">
            @(saving ? "Saving..." : "Update")
        </button>
        <button class="btn btn-secondary" @onclick="Cancel" disabled="@saving">Cancel</button>
    </fieldset>
}

@code {
    [Parameter]
    public int Id { get; set; }

    private CreateProductDto? model;
    private bool loading = true;
    private bool saving;
    private string? error;

    protected override async Task OnParametersSetAsync()
    {
        loading = true;
        model = null;
        error = null;
        try
        {
            var product = await ProductApi.GetByIdAsync(Id);
            if (product == null)
            {
                error = "Product not found.";
                return;
            }

            model = new CreateProductDto
            {
                Code = product.Code,
                Name = product.Name,
                UnitPrice = product.UnitPrice
            };
        }
        catch (HttpRequestException ex) when (ex.StatusCode == System.Net.HttpStatusCode.NotFound)
        {
            error = "Product not found.";
        }
        catch (Exception)
        {
            error = "Unable to load product. Please try again.";
        }
        finally
        {
            loading = false;
        }
    }

    private async Task Save()
    {
        if (saving || model == null)
            return;

        error = null;
        if (string.IsNullOrWhiteSpace(model.Code) || string.IsNullOrWhiteSpace(model.Name))
        {
            error = "Product code and name are required.";
            return;
        }

        if (model.UnitPrice < 0)
        {
            error = "Unit price cannot be negative.";
            return;
        }

        saving = true;
        try
        {
            var result = await ProductApi.UpdateAsync(Id, model);
            if (result.Product != null)
                Navigation.NavigateTo("/products");
            else
                error = result.Error ?? "Unable to update product.";
        }
        catch (Exception)
        {
            error = "Unable to update product. Please try again.";
        }
        finally
        {
            saving = false;
        }
    }

    private void Cancel() => Navigation.NavigateTo("/products");
}
