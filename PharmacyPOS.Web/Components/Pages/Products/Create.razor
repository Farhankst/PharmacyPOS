@page "/products/create"
@attribute [Authorize(Policy = AccessPolicies.ProductWrite)]

@using PharmacyPOS.Application.DTOs.Products


@inject AuthorizedProductService ProductApi
@inject NavigationManager Navigation

<h3>Create Product</h3>
@if (error != null) { <div class="alert alert-danger">@error</div> }

<div class="mb-3">
    <label>Product Code</label>

    <input class="form-control"
           @bind="model.Code" />
</div>

<div class="mb-3">
    <label>Product Name</label>

    <input class="form-control"
           @bind="model.Name" />
</div>

<div class="mb-3">
    <label>Unit Price</label>

    <input type="number"
           class="form-control"
           @bind="model.UnitPrice" />
</div>

<button class="btn btn-primary"
        @onclick="Save"
        disabled="@saving">

    @(saving ? "Saving..." : "Save")

</button>

@code {

    private CreateProductDto model = new();

    private bool saving;
    private string? error;

    private async Task Save()
    {
        try
        {
            saving = true;
            error = null;

            var result = await ProductApi.CreateAsync(model);

            if (result != null)
            {
                Navigation.NavigateTo("/products");
            }
        }
        catch (UnauthorizedAccessException)
        {
            error = "Your session or permissions have changed. Please sign in again.";
        }
        catch (Exception)
        {
            error = "Unable to create product. Please try again.";
        }
        finally
        {
            saving = false;
        }
    }
}