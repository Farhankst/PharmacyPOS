@page "/products"

@using PharmacyPOS.Application.DTOs.Products
@using PharmacyPOS.Web.Services.ApiClients

@inject ProductApiClient ProductApi

<h3>Product List</h3>

@if (products == null)
{
    <p>Loading Products...</p>
}
else
{
    <table class="table table-bordered">

        <thead>
            <tr>
                <th>Code</th>
                <th>Name</th>
                <th>Unit Price</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var item in products)
            {
                <tr>
                    <td>@item.Code</td>
                    <td>@item.Name</td>
                    <td>@item.UnitPrice</td>
                </tr>
            }
        </tbody>

    </table>
}

@code {

    private List<ProductDto>? products;

    protected override async Task OnInitializedAsync()
    {
        products = await ProductApi.GetAllAsync();
    }
}