@page "/products"
@attribute [Authorize(Policy = AccessPolicies.ProductRead)]

@using PharmacyPOS.Application.DTOs.Products


@inject AuthorizedProductService ProductApi

<h3>Product List</h3>

@if (products == null)
{
    <p>Loading Products...</p>
}
else
{
    <table class="table table-bordered">

        <thead>
            <tr>
                <th>Code</th>
                <th>Name</th>
                <th>Unit Price</th>
                <th>Action</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var item in products)
            {
                <tr>
                    <td>@item.Code</td>
                    <td>@item.Name</td>
                    <td>@item.UnitPrice</td>
                    <td><AuthorizeView Policy="@AccessPolicies.ProductWrite"><a class="btn btn-primary btn-sm" href="@($"/products/edit/{item.Id}")">Edit</a></AuthorizeView></td>
                </tr>
            }
        </tbody>

    </table>
}

@code {

    private List<ProductDto>? products;

    protected override async Task OnInitializedAsync()
    {
        products = await ProductApi.GetAllAsync();
    }
}