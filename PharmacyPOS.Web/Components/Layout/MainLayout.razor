@inherits LayoutComponentBase

<header class="border-bottom p-3 mb-3">
    <nav class="d-flex flex-wrap align-items-center gap-3">
        <a href="/">PharmacyPOS</a>
        <AuthorizeView>
            <Authorized>
                <AuthorizeView Policy="@AccessPolicies.ProductRead" Context="productReader">
                    <a href="/products">Products</a>
                </AuthorizeView>
                <AuthorizeView Policy="@AccessPolicies.ProductWrite" Context="productWriter">
                    <a href="/products/create">Create Product</a>
                </AuthorizeView>
                <AuthorizeView Roles="@AppRoles.Admin" Context="admin">
                    <a href="/Account/Users">Users</a>
                </AuthorizeView>
                <a href="/Account/Manage">My Account</a>
                <form action="/Account/Logout" method="post" data-enhance="false" class="ms-auto">
                    <AntiforgeryToken />
                    <input type="hidden" name="returnUrl" value="Account/Login" />
                    <button class="btn btn-outline-secondary btn-sm" type="submit">Logout</button>
                </form>
            </Authorized>
            <NotAuthorized><a href="/Account/Login">Login</a></NotAuthorized>
        </AuthorizeView>
    </nav>
</header>
<main class="container py-3">
    @Body
</main>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>
